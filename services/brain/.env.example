# ============ LLM (OpenAI 协议) ============
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# ============ Whisper / ASR（OpenAI 兼容） ============
WHISPER_API_KEY=
WHISPER_BASE_URL=https://aihubmix.com/v1
WHISPER_MODEL=whisper-large-v3
# aihubmix 国内直连不通时走本地 HTTP 代理，留空则直连
WHISPER_PROXY=http://127.0.0.1:7890

# ============ TTS — fish.audio ============
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE=09803a7b68fd41d7b4171c63ce06243b
# api.fish.audio 国内直连不通时走本地 HTTP 代理（如 Clash 默认 7890），留空则直连
FISH_AUDIO_PROXY=http://127.0.0.1:7890

# ============ 联网搜索 ============
# 可选：Tavily 密钥（质量最好，配了会优先使用）。留空时用免密钥引擎：
# 必应 → 360 → 搜狗 → DuckDuckGo，自动降级。
TAVILY_API_KEY=
# 各引擎端点可用环境变量覆盖（镜像站 / 自建代理）。留空 = 官方地址。
# SEARCH_BING_URL=https://cn.bing.com/search
# SEARCH_SO_URL=https://www.so.com/s
# SEARCH_SOGOU_URL=https://www.sogou.com/web
# SEARCH_DUCKDUCKGO_URL=https://html.duckduckgo.com/html/
# 独立搜索/网页代理：不设置时继承实际模型的代理；显式空值 = 直连。
# SEARCH_PROXY=

# ============ 服务 ============
PORT=3002
# SQLite 数据库文件（无需安装数据库服务）。默认 services/brain/data/amadeus.db；
# 相对路径按启动目录解析，绝对路径直接使用。
# DB_PATH=

# ============ 飞书 ============
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu

# ============ LLM (OpenAI 协议) ============
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-pro

# ============ Whisper / ASR（OpenAI 兼容） ============
WHISPER_API_KEY=
WHISPER_BASE_URL=https://aihubmix.com/v1
WHISPER_MODEL=whisper-large-v3
# aihubmix 国内直连不通时走本地 HTTP 代理，留空则直连
WHISPER_PROXY=http://127.0.0.1:7890

# ============ TTS — fish.audio ============
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE=09803a7b68fd41d7b4171c63ce06243b
# api.fish.audio 国内直连不通时走本地 HTTP 代理（如 Clash 默认 7890），留空则直连
FISH_AUDIO_PROXY=http://127.0.0.1:7890

# ============ 服务 ============
PORT=3002
# SQLite 数据库文件（无需安装数据库服务）。默认 services/brain/data/amadeus.db；
# 相对路径按启动目录解析，绝对路径直接使用。
# DB_PATH=

# ============ 飞书 ============
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
